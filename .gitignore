# Godot 4 generated
.godot/
/android/
*.translation

# Editor / OS
.import/
export_presets.cfg
*.tmp
Thumbs.db

# Godot tries to import .csv as translations; results are data, not assets
*.csv.import

# 丢在根目录的临时截图（Godot 会给它生成 .import）
/*.png
/*.png.import

# 模拟输出（大批量 CSV 不进库，结论写进 docs/balance/）
/out/*.csv

# Python
__pycache__/
*.pyc

# sweep 脚本的崩溃保护备份，跑完自动删，永远不该进仓库
*.sweepbak
