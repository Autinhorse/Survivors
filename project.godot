; Godot 3D Feasibility Benchmark
; See docs/GODOT_3D_可行性验证需求.md

config_version=5

[application]

config/name="Survivors 3D Benchmark"
config/version="0.1.0"
config/description="Vertical slice benchmark for Godot 4 (see docs/GODOT_3D_可行性验证需求.md)"
run/main_scene="res://scenes/VisualBenchmark.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
